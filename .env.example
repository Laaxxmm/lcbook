# ─────────────────────────────────────────────────────────────────────────────
# Learn Crew Publications — environment (spec §19.4). Copy to .env and fill in.
# .env is gitignored. Never commit real secrets. key_secret is SERVER-ONLY.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (Railway in prod). Prisma reads DATABASE_URL.
DATABASE_URL="postgresql://lc:lcpass@localhost:5432/lc_publications"
# Used only by the test suite (integration tests run against REAL Postgres).
TEST_DATABASE_URL="postgresql://lc:lcpass@localhost:5432/lc_publications_test"

# ── Razorpay (dedicated publications MID, separate from coaching) ──
# key_id is exposed to the browser (Checkout). NEXT_PUBLIC_ is intentional.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
# key_secret NEVER leaves the server. No NEXT_PUBLIC_ prefix.
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Webhook signing secret (Razorpay dashboard → Webhooks). Server-only.
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Money (§4) ──
# Gateway fee retained on refund: 2% Razorpay + 18% GST on the fee = 2.36%.
GATEWAY_FEE_RATE="0.0236"
# GST fields are built but dormant until this is true (§12).
GST_ENABLED="false"

# ── Resend transactional email (§11) ──
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="orders@learncrew.org"
EMAIL_REPLY_TO="support@learncrew.org"

# ── Google Sheet sync (Apps Script web app, §10) ──
SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/XXXX/exec"
SHEETS_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxx"

# ── Auth / app (§8) ──
# Secret used to sign single-use magic links / order-tracking tokens.
AUTH_TOKEN_SECRET="change-me-to-a-long-random-string"
# Public base URL, used to build magic links.
NEXT_PUBLIC_APP_URL="https://publications.learncrew.org"
# Guest checkout is the default path (§8). Set true to force login.
REQUIRE_LOGIN_AT_CHECKOUT="false"
